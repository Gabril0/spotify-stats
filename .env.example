# Client ID from your Spotify app, get it from the Spotify Developer Dashboard
# (https://developer.spotify.com/dashboard)
CLIENT_ID=

# Client secret from your Spotify app (same dashboard page as above)
CLIENT_SECRET=

# Port the server listens on. Must match the port used in your Spotify app's
# Redirect URI: http://127.0.0.1:{PORT}/api/callback
PORT=8080
